# ============================================================================
# SecureScan Pro — plantilla de variables de entorno
# ============================================================================
#
# CÓMO USAR ESTE ARCHIVO:
#
#   1. Copia este archivo a ".env" (mismo nivel que docker-compose.yml):
#
#        Windows (PowerShell o CMD):   copy .env.example .env
#        Mac/Linux:                    cp .env.example .env
#
#   2. Abre el ".env" y llena SOLO las API keys reales que quieras activar
#      (ver sección 1 abajo). Todo lo demás ya viene con valores que
#      funcionan de una para probar en tu PC.
#
#   3. docker-compose lee "${VAR:-default}" automáticamente desde el ".env"
#      — no hace falta exportar nada a mano ni reiniciar variables de sistema.
#
#   4. El ".env" real NUNCA debe subirse a git (ya debería estar en
#      .gitignore). Este ".env.example" sí se sube, porque no tiene
#      secretos reales, solo la plantilla.
#
# ============================================================================


# ============================================================================
# SECCIÓN 1 — API KEYS EXTERNAS (las únicas que de verdad tienes que "ir a
# buscar" a algún lado. TODAS son opcionales: si las dejas vacías, esa
# funcionalidad puntual cae a modo simulación/limitado, pero el resto de
# SecureScan Pro funciona exactamente igual.)
# ============================================================================

# VirusTotal — reputación de IPs/dominios/hashes (panel "Huella Digital")
# Gratis: https://www.virustotal.com/gui/join-us  (~4 consultas/min)
# Cómo obtenerla: crea cuenta → ícono de tu perfil (arriba derecha) → "API Key"
VIRUSTOTAL_API_KEY=

# AbuseIPDB — reputación de IPs por reportes de abuso (panel "Huella Digital")
# Gratis: https://www.abuseipdb.com/register  (~1000 consultas/día)
# Cómo obtenerla: crea cuenta → "Account" → "API" → "Create Key"
ABUSEIPDB_API_KEY=

# Google Safe Browsing — verifica si un sitio está marcado como malicioso
# Gratis: 10,000 consultas/día. Cómo obtenerla:
#   https://console.cloud.google.com → crear/seleccionar proyecto →
#   "APIs & Services" → "Library" → buscar "Safe Browsing API" → "Enable" →
#   "Credentials" → "Create Credentials" → "API Key"
GOOGLE_SAFE_BROWSING_API_KEY=

# NVD (National Vulnerability Database) — acelera OWASP Dependency-Check.
# Sin esta key, Dependency-Check igual funciona, solo sincroniza su base de
# datos de CVEs más lento por el rate-limit público de NVD.
# Gratis: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=


# ============================================================================
# SECCIÓN 2 — Contraseñas internas (NO hay que "conseguirlas" de ningún
# lado externo: son solo strings que protegen la comunicación ENTRE los
# contenedores de tu propia instalación. Ya vienen con valores random
# generados en el ".env" listo para usar — no tienes que tocar nada acá
# para simplemente probar el proyecto en tu PC).
# ============================================================================

# Firma sesiones/tokens de Flask.
SECRET_KEY=dev-key-change-in-production

# Token que el frontend manda en cada request al backend. Vacío = sin
# autenticación entre frontend y backend (solo recomendable en tu propia PC,
# nunca si expones el backend a internet).
API_TOKEN=

# Contraseña de Redis (cola de Jobs + almacenamiento de escaneos).
REDIS_PASSWORD=changeme-redis-password

# API key interna de OWASP ZAP (el backend se la manda al contenedor de ZAP).
ZAP_API_KEY=securescan-dev-key-2024

# Contraseña interna de la API de SQLMap.
SQLMAP_API_PASSWORD=sqlmapsecret

# Contraseña del RPC de Metasploit.
MSF_PASSWORD=msf

# Credenciales de la base de datos del lab DVWA (solo se usan entre DVWA y
# su propio contenedor de MySQL, no se exponen a internet).
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=dvwa
MYSQL_USER=dvwa
MYSQL_PASSWORD=p@ssw0rd


# ============================================================================
# SECCIÓN 3 — Configuración de la app (valores por defecto razonables,
# normalmente no hace falta tocarlos para desarrollo local)
# ============================================================================

FLASK_ENV=development
FLASK_DEBUG=0

# Ejecución de Jobs (Celery):
#   auto   → usa Celery si el broker responde, si no cae a threading.Thread
#   celery → fuerza Celery (requiere celery-worker corriendo)
#   thread → fuerza threading.Thread (sin Celery)
JOB_BACKEND=auto
CELERY_WORKER_CONCURRENCY=2
SCHEDULER_POLL_SECONDS=60

# Caché OSINT (XposedOrNot / Username Search) — tiempo de vida en segundos.
OSINT_CACHE_TTL_SECONDS=3600


# ============================================================================
# SECCIÓN 4 — Notificaciones (100% opcional, vacío = deshabilitado)
# ============================================================================

SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_USE_TLS=true
NOTIFY_EMAIL_TO=
WEBHOOK_URL=
WEBHOOK_TIMEOUT_SECONDS=5
WEBHOOK_MAX_RETRIES=2
